// Модуль HTTP-сервиса HelloService.
// Базовый вариант лабораторной работы: ответ «Привет, мир!».

Функция RootGET(Запрос) Экспорт

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить(
        "Content-Type",
        "text/html; charset=utf-8"
    );
    Ответ.УстановитьТелоИзСтроки("<h1>Привет, мир!</h1>");

    Возврат Ответ;

КонецФункции
