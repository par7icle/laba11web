// Модуль HTTP-сервиса HelloService.
// Индивидуальное задание: сведения о студенте и вычисление числа π

Функция RootGET(Запрос) Экспорт

    ФИО = "Кизел Диана Александровна";
    Группа = "478";

    Пи = Окр(ВычислитьПи(), 9);
    ПиСтрокой = СтрЗаменить(Строка(Пи), ",", ".");

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить(
        "Content-Type",
        "text/html; charset=utf-8"
    );

    ТелоОтвета =
        "<h1>Привет, мир!</h1>"
        + ФИО + "<br>"
        + Группа + "<br>"
        + ПиСтрокой;

    Ответ.УстановитьТелоИзСтроки(ТелоОтвета);

    Возврат Ответ;

КонецФункции

Функция ВычислитьПи()

    // Формула Нилаканты:
    // π = 3 + 4/(2×3×4) - 4/(4×5×6) + 4/(6×7×8) - ...
    Пи = 3;
    Знак = 1;

    Для Номер = 1 По 5000 Цикл

        Число = 2 * Номер;
        Слагаемое =
            4 /
            (Число
            * (Число + 1)
            * (Число + 2));

        Пи = Пи + Знак * Слагаемое;
        Знак = -Знак;

    КонецЦикла;

    Возврат Пи;

КонецФункции
